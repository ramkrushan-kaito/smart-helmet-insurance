# Local PostgreSQL only. Do not point this file at a hosted database.
# macOS Homebrew usually trusts the current OS user with no password.
# Example: postgresql://YOUR_OS_USER@localhost:5432/smart_helmet_insurance?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_helmet_insurance?schema=public"

# Required. Use a long random value outside this demo.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Demo OTP. No SMS is sent while SMS_PROVIDER=none.
DEMO_OTP_ENABLED="true"
DEMO_OTP_CODE="123456"
OTP_EXPIRY_SECONDS="300"
OTP_MAX_REQUESTS="5"
OTP_WINDOW_SECONDS="900"
SMS_PROVIDER="none"

# Printed QR codes open this origin + /scan/TOKEN.
# Local Nest redirects /scan/* to FRONTEND_URL during development.
QR_PUBLIC_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"
PORT="3000"
NODE_ENV="development"
SWAGGER_ENABLED="true"
